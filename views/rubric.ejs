<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Marking Rubric</title><link rel="stylesheet" href="/styles.css"></head><body><header><a class="brand" href="/">STEM Journey</a><nav><a href="/teacher">Teacher</a><a href="/student">Student</a><a href="/rubric">Rubric</a><a href="/student-evidence-template">Evidence Template</a></nav></header><main><section class="pagehead"><span class="pill">Assessment</span><h1>100-Mark STEM Rubric</h1><p>Designed to reward design thinking, manufacture, electronics, programming, testing and individual evidence.</p></section><div class="tablewrap"><table><thead><tr><th>Criterion</th><th>Marks</th><th>A</th><th>B</th><th>C</th><th>D</th><th>E</th></tr></thead><tbody><% rubric.forEach(r=>{ %><tr><th><%=r.criterion%></th><td><strong><%=r.marks%></strong></td><td><%=r.a%></td><td><%=r.b%></td><td><%=r.c%></td><td><%=r.d%></td><td><%=r.e%></td></tr><% }) %></tbody></table></div></main><footer>Year 9 STEM • Farting Bin Engineering Challenge • 7 weeks</footer><script src="/app.js"></script></body></html>