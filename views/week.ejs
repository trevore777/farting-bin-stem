<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Week <%= week.week %></title><link rel="stylesheet" href="/styles.css"></head><body><header><a class="brand" href="/">STEM Journey</a><nav><a href="/teacher">Teacher</a><a href="/student">Student</a><a href="/rubric">Rubric</a><a href="/student-evidence-template">Evidence Template</a></nav></header><main><section class="pagehead"><span class="pill">Week <%=week.week%></span><h1><%=week.title%></h1><p><%=week.focus%></p></section><section class="lesson-grid"><% week.lessons.forEach(l=>{ %><article class="lesson"><div class="lesson-tag">Lesson <%=l.n%> • 40 min</div><h2><%=l.title%></h2><h3>What you do</h3><p><%=l.student%></p><h3>Evidence to capture</h3><p><%=l.evidence%></p><label class="done"><input class="lessonCheck" data-key="w<%=week.week%>l<%=l.n%>" type="checkbox"> Mark lesson complete</label></article><% }) %></section><div class="actions"><% if(week.week>1){%><a class="button secondary" href="/week/<%=week.week-1%>">← Previous week</a><%}%><%if(week.week<7){%><a class="button" href="/week/<%=week.week+1%>">Next week →</a><%}%></div></main><footer>Year 9 STEM • Farting Bin Engineering Challenge • 7 weeks</footer><script src="/app.js"></script></body></html>