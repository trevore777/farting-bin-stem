<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Student Journey</title><link rel="stylesheet" href="/styles.css"></head><body><header><a class="brand" href="/">STEM Journey</a><nav><a href="/teacher">Teacher</a><a href="/student">Student</a><a href="/rubric">Rubric</a><a href="/student-evidence-template">Evidence Template</a></nav></header><main><section class="pagehead"><span class="pill">Student View</span><h1>Your 7-Week Engineering Journey</h1><p>Complete the lesson tasks and capture your own evidence as you go. Your progress is stored in this browser for the prototype.</p></section><div class="progressbox"><div><strong id="progressText">0 / 28 lessons complete</strong></div><div class="bar"><span id="progressBar"></span></div></div><section class="weeklist"><% weeks.forEach(w=>{ %><article class="weekcard"><div class="weeknum">W<%=w.week%></div><div class="grow"><h2><%=w.title%></h2><p><%=w.focus%></p><div class="checks"><% w.lessons.forEach(l=>{ const key='w'+w.week+'l'+l.n; %><label><input class="lessonCheck" data-key="<%=key%>" type="checkbox"> <strong>L<%=l.n%>:</strong> <%=l.title%></label><% }) %></div><a href="/week/<%=w.week%>">Open instructions →</a></div></article><% }) %></section></main><footer>Year 9 STEM • Farting Bin Engineering Challenge • 7 weeks</footer><script src="/app.js"></script></body></html>